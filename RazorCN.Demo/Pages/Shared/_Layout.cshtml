<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - RazorCN.Demo</title>
    <link rel="stylesheet" href="~/_content/RazorCN/css/razorcn.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/RazorCN.Demo.styles.css" asp-append-version="true"/>
</head>
<body class="min-h-screen flex flex-col">
<header class="border-b border-border bg-background">
    <nav class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
        <a class="font-semibold text-foreground" asp-area="" asp-page="/Index">RazorCN.Demo</a>
        <div class="flex items-center gap-6">
            <a class="text-sm text-muted-foreground hover:text-foreground transition-colors" asp-area="" asp-page="/Index">Home</a>
            <a class="text-sm text-muted-foreground hover:text-foreground transition-colors" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </nav>
</header>

<div class="flex-1">
    <main class="max-w-5xl mx-auto px-4 py-8">
        @RenderBody()
    </main>
</div>

<footer class="border-t border-border py-6 text-sm text-muted-foreground">
    <div class="max-w-5xl mx-auto px-4">
        &copy; 2026 - RazorCN.Demo - <a class="hover:text-foreground transition-colors" asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
