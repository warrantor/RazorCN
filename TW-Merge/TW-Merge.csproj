<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>TW_Merge</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- NuGet Package Configuration -->
    <PropertyGroup>
        <PackageId>RazorCN.TwMerge</PackageId>
        <Version>0.1.0</Version>
        <Authors>RazorCN Contributors</Authors>
        <Description>Tailwind CSS class merging utility for .NET. A port of tailwind-merge for C#.</Description>
        <PackageTags>tailwind;css;merge;utility</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

</Project>